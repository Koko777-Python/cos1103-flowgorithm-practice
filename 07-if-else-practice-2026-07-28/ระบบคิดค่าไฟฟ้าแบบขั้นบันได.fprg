<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="&#3619;&#3632;&#3610;&#3610;&#3588;&#3636;&#3604;&#3588;&#3656;&#3634;&#3652;&#3615;&#3615;&#3657;&#3634;&#3649;&#3610;&#3610;&#3586;&#3633;&#3657;&#3609;&#3610;&#3633;&#3609;&#3652;&#3604;"/>
        <attribute name="authors" value="VICTUS GAMING 16"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-08-03 10:26:40 PM"/>
        <attribute name="created" value="VklDVFVTIEdBTUlORyAxNjtERVNLVE9QLTFDS0EzSzc7MjAyNi0wNy0yODswODowOTo1NSBQTTszMzk4"/>
        <attribute name="edited" value="VklDVFVTIEdBTUlORyAxNjtERVNLVE9QLTFDS0EzSzc7MjAyNi0wOC0wMzsxMDoyNjo0MCBQTTsyOzM0ODc="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="unit, Rate" type="Integer" array="False" size=""/>
            <declare name="bill" type="Integer" array="False" size=""/>
            <output expression="&quot;Enter Unit&quot;" newline="True"/>
            <input variable="unit"/>
            <if expression="unit&lt;0">
                <then>
                    <output expression="&quot;Invalid Unit&quot;" newline="True"/>
                </then>
                <else>
                    <if expression="unit&lt;=100">
                        <then>
                            <assign variable="rate" expression="3"/>
                        </then>
                        <else>
                            <if expression="unit&lt;=300">
                                <then>
                                    <assign variable="rate" expression="5"/>
                                </then>
                                <else>
                                    <assign variable="rate" expression="7"/>
                                </else>
                            </if>
                        </else>
                    </if>
                    <assign variable="bill" expression="unit*rate"/>
                    <output expression="&quot;Electricity Unit = &quot;&amp;unit&amp;&quot;  Unit&quot;" newline="True"/>
                    <output expression="&quot;Rate = &quot;&amp;rate&amp;&quot;  Baht&quot;" newline="True"/>
                    <output expression="&quot;Bill = &quot;&amp;bill&amp;&quot;  Baht&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
