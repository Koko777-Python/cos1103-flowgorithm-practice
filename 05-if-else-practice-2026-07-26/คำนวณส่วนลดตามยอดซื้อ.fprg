<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="&#3588;&#3635;&#3609;&#3623;&#3603;&#3626;&#3656;&#3623;&#3609;&#3621;&#3604;&#3605;&#3634;&#3617;&#3618;&#3629;&#3604;&#3595;&#3639;&#3657;&#3629;"/>
        <attribute name="authors" value="VICTUS GAMING 16"/>
        <attribute name="about" value=""/>
        <attribute name="saved" value="2026-07-30 09:28:49 PM"/>
        <attribute name="created" value="VklDVFVTIEdBTUlORyAxNjtERVNLVE9QLTFDS0EzSzc7MjAyNi0wNy0yNjswNjoxNzo0OCBQTTszMzk1"/>
        <attribute name="edited" value="VklDVFVTIEdBTUlORyAxNjtERVNLVE9QLTFDS0EzSzc7MjAyNi0wNy0zMDswOToyODo0OSBQTTsyOzM1MDU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="Purchase, Discount, NetPrice" type="Real" array="False" size=""/>
            <do expression="Purchase&lt;0">
                <output expression="&quot;Enter the Purchare amount&quot;" newline="True"/>
                <input variable="Purchase"/>
            </do>
            <if expression="Purchase&gt;=5000">
                <then>
                    <assign variable="Discount" expression="Purchase*15/100"/>
                </then>
                <else>
                    <if expression="Purchase&gt;=1000">
                        <then>
                            <assign variable="Discount" expression="Purchase*10/100"/>
                        </then>
                        <else>
                            <assign variable="Discount" expression="0"/>
                        </else>
                    </if>
                </else>
            </if>
            <assign variable="NetPrice" expression="Purchase-Discount"/>
            <output expression="&quot;Purchase = &quot;&amp;Purchase&amp;&quot;  Baht&quot;" newline="True"/>
            <output expression="&quot;Discount = &quot;&amp;Discount&amp;&quot;  Baht&quot;" newline="True"/>
            <output expression="&quot;NetPrice = &quot;&amp;NetPrice&amp;&quot;  Baht&quot;" newline="True"/>
        </body>
    </function>
</flowgorithm>
