        <attribute name="edited" value="VklDVFVTIEdBTUlORyAxNjtERVNLVE9QLTFDS0EzSzc7MjAyNi0wNy0yNjswNTowMzo1NSBQTTsxOzM0OTU="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="number" type="Integer" array="False" size=""/>
            <output expression="&quot;Enter Number&quot;" newline="True"/>
            <input variable="number"/>
            <if expression="number&gt;0">
                <then>
                    <if expression="number Mod 2 = 0">
                        <then>
                            <output expression="&quot;Positive Even&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Positive Odd&quot;" newline="True"/>
                        </else>
                    </if>
                </then>
                <else>
                    <output expression="&quot;Invalid Number&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
